# Docker Compose 配置。部署到云主机前必须替换所有占位值和密码。
# 密码会直接拼入数据库 URL，生产环境请使用仅含字母、数字、下划线和连字符的随机值。
POSTGRES_DB=docmind
POSTGRES_PASSWORD=docmind_local
POSTGRES_USER=docmind
# 数据库和 Redis 仅绑定到云主机的 127.0.0.1，不直接暴露公网。
POSTGRES_PORT=15432
REDIS_PORT=16379

# 全栈应用端口。直接通过宿主机访问时使用 http://SERVER_IP:FRONTEND_HTTP_PORT。
BIND_ADDRESS=127.0.0.1
FRONTEND_HTTP_PORT=15173

# 生产构建通常保持为空，由 Nginx 同源代理 /api；跨域部署才填写完整源地址。
VITE_API_BASE_URL=

# --profile tls 使用的 Caddy 配置。DOMAIN 必须已解析到当前云主机。
DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
