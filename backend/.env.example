APP_ENV=development
DATABASE_URL=postgresql+psycopg://docmind:docmind_local@127.0.0.1:15432/docmind
REDIS_URL=redis://127.0.0.1:16379/0

# 上传与结构感知切片配置。
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_BYTES=20971520
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.md,.markdown
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=10

# Celery 默认复用 Redis；结果后端使用单独 DB 避免与缓存键混用。
CELERY_BROKER_URL=redis://127.0.0.1:16379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/1

# LLM credentials: never commit real values.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
LLM_CONFIG_PATH=
