# 应用基础配置。
APP_NAME=DocMind API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://docmind:docmind_local@127.0.0.1:15432/docmind
REDIS_URL=redis://127.0.0.1:16379/0
LLM_CONFIG_PATH=

# 上传白名单与结构感知切片。
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_BYTES=20971520
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.md,.markdown
CHUNK_SIZE=512
CHUNK_OVERLAP=64
PARENT_CHILD_ENABLED=true
PARENT_CHUNK_SIZE=2048
EMBEDDING_BATCH_SIZE=10
OCR_ENABLED=false
OCR_LANGUAGE=chi_sim+eng

# 检索、RAG、拒答与重排。
RETRIEVAL_TOP_K=10
RAG_CANDIDATE_TOP_K=20
RAG_CONTEXT_TOP_K=5
RAG_REFUSAL_THRESHOLD=0.0
RAG_RETRIEVAL_MODE=hybrid
RERANK_ENABLED=true
RERANK_PROVIDER=llm
RERANK_BASE_URL=
RERANK_API_KEY_ENV=RERANK_API_KEY
RERANK_TIMEOUT_SECONDS=30

# Redis 答案缓存与令牌桶限流。
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=3600
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1

# 可观测性、CORS 与接口鉴权。
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:15173,http://localhost:15173
REQUIRE_API_KEY=false
API_KEYS=

# Celery 默认复用 Redis；结果后端使用单独 DB 避免与缓存键混用。
CELERY_BROKER_URL=redis://127.0.0.1:16379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/1

# 模型网关密钥。只填写环境变量，禁止提交真实密钥。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
RERANK_API_KEY=
LOCAL_LLM_API_KEY=
